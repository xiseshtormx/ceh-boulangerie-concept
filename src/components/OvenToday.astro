---
import { Image } from 'astro:assets';
import lineup from '../assets/pastry-lineup-v2.png';
import { products } from '../data/products';
import { links } from '../data/links';
import '../styles/vitrine.css';
---

<section class="ceh-vitrine" id="batch" aria-labelledby="batch-title" data-vitrine>
  <div class="ceh-vitrine__inner">
    <header class="ceh-vitrine__heading">
      <h2 id="batch-title">На витрине</h2>
      <a href={links.menu} target="_blank" rel="noreferrer">Посмотреть всё меню</a>
    </header>

    <div class="ceh-vitrine__body">
      <label class="ceh-vitrine__picker" data-pastry-picker hidden>
        <span class="ceh-vitrine__sr-only">Выберите выпечку</span>
        <select data-pastry-select aria-controls="vitrine-gallery">
          {products.map((product, index) => <option value={index}>{product.name}</option>)}
        </select>
      </label>
      <div class="ceh-vitrine__gallery" id="vitrine-gallery" aria-live="polite" aria-atomic="true">
        {products.map((product, index) => (
          <figure class="ceh-vitrine__panel" data-pastry-panel={index} aria-labelledby={`pastry-${product.id}`}>
            <div class="ceh-vitrine__image">
              <Image
                src={lineup}
                alt={`Визуал концепта: ${product.name.toLocaleLowerCase('ru-RU')}`}
                widths={[768, 1200, 1536]}
                sizes="(min-width: 720px) 1536px, 300vw"
                quality={84}
                loading="lazy"
                decoding="async"
                style={`--pastry-crop: ${product.crop}`}
              />
            </div>
            <figcaption class="ceh-vitrine__description">
              <h3 id={`pastry-${product.id}`}>{product.name}</h3>
              <p>{product.description}</p>
            </figcaption>
          </figure>
        ))}
      </div>

      <fieldset class="ceh-vitrine__choices" data-pastry-choices hidden>
        <legend class="ceh-vitrine__sr-only">Выберите выпечку</legend>
        {products.map((product, index) => (
          <label class="ceh-vitrine__choice">
            <input type="radio" name="pastry" value={index} checked={index === 0} aria-controls="vitrine-gallery" />
            <span>{product.name}</span>
          </label>
        ))}
      </fieldset>
    </div>

    <p class="ceh-vitrine__note">Иллюстрации созданы для концепта. Наличие и цены — в меню выбранной кофейни.</p>
  </div>
</section>

<script>
  const vitrine = document.querySelector<HTMLElement>('[data-vitrine]');
  const choices = vitrine?.querySelector<HTMLFieldSetElement>('[data-pastry-choices]');
  const picker = vitrine?.querySelector<HTMLElement>('[data-pastry-picker]');
  const select = vitrine?.querySelector<HTMLSelectElement>('[data-pastry-select]');
  const panels = vitrine ? [...vitrine.querySelectorAll<HTMLElement>('[data-pastry-panel]')] : [];
  const inputs = choices ? [...choices.querySelectorAll<HTMLInputElement>('input[type="radio"]')] : [];

  if (vitrine && choices && panels.length && panels.length === inputs.length) {
    const selectPastry = (index: number) => {
      if (!Number.isInteger(index) || index < 0 || index >= panels.length) return;
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      inputs.forEach((input, inputIndex) => { input.checked = inputIndex === index; });
      if (select) select.value = String(index);
    };
    inputs.forEach((input) => input.addEventListener('change', () => {
      if (input.checked) selectPastry(Number(input.value));
    }));
    select?.addEventListener('change', () => selectPastry(Number(select.value)));
    selectPastry(0);
    vitrine.classList.add('is-interactive');
    choices.hidden = false;
    if (picker && select) picker.hidden = false;
  }
</script>
