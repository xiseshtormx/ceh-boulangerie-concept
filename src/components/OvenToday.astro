---
import { Image } from 'astro:assets';
import bakeryGrid from '../assets/bakery-grid.webp';
import { products } from '../data/products';
import { links } from '../data/links';
import { imageMeta } from '../data/images';
---

<section class="section oven" id="oven" aria-labelledby="oven-title">
  <div class="section-head" data-reveal>
    <p class="eyebrow">СЕГОДНЯ ИЗ ПЕЧИ · 01</p>
    <h2 id="oven-title">То, что лучше<br /><em>не откладывать на вечер.</em></h2>
    <p>Названия сверены с публичным меню. Фото, описания и компоновка — часть концепта.</p>
  </div>

  <div class="product-grid">
    {products.map((product, index) => (
      <article class="product-card" data-reveal style={`--delay: ${index * 55}ms`}>
        <a href={product.source} target="_blank" rel="noreferrer" aria-label={`${product.name} — открыть источник`}>
          <div class="product-image">
            <Image
              src={bakeryGrid}
              alt={`${imageMeta.products.altPrefix} «${product.type}»`}
              widths={[480, 720]}
              sizes="(max-width: 767px) 88vw, (max-width: 1199px) 45vw, 30vw"
              loading="lazy"
              quality={82}
              style={`object-position: ${product.crop}`}
            />
            <span>{product.demoVisual ? 'concept visual' : 'menu visual'}</span>
          </div>
          <div class="product-meta">
            <p>{String(index + 1).padStart(2, '0')} · {product.type}</p>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
            <div><strong>{product.price}</strong><span>В меню ↗</span></div>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="oven-note">
    <p>Состав, наличие и цены могут меняться.</p>
    <a class="button button--outline" href={links.menu} target="_blank" rel="noreferrer">Актуальное меню <span>↗</span></a>
  </div>
</section>
