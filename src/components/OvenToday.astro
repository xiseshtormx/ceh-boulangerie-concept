---
import { Image } from 'astro:assets';
import lineup from '../assets/pastry-lineup-v2.png';
import { products } from '../data/products';
import { links } from '../data/links';
---

<section class="batch section" id="batch" aria-labelledby="batch-title">
  <div class="batch-intro" data-reveal>
    <div>
      <p class="section-code micro">01 / ВИТРИНА</p>
      <h2 id="batch-title">То, что лучше<br /><span>не откладывать на вечер.</span></h2>
    </div>
    <p>Классика, миндаль, шоколад, фисташка и ягоды — выбирайте то, что зовёт с витрины громче остальных.</p>
  </div>

  <div class="product-rail-head" data-reveal>
    <p class="product-counter" aria-live="polite"><strong data-product-current>01</strong><span>/ {String(products.length).padStart(2, '0')}</span></p>
    <div class="product-arrows">
      <button type="button" data-products-prev aria-label="Предыдущая позиция">←</button>
      <button type="button" data-products-next aria-label="Следующая позиция">→</button>
    </div>
  </div>
  <div class="product-run" data-product-run>
    {products.map((product, index) => (
      <article class="product-card" data-reveal style={`--delay: ${Math.min(index * 45, 180)}ms`}>
        <a href={product.source} target="_blank" rel="noreferrer" aria-label={`${product.name}: проверить в актуальном меню`}>
          <div class="product-image">
            <Image src={lineup} alt={`Демонстрационная визуализация: ${product.name}`} widths={[720, 1200]} sizes="(min-width: 1000px) 72rem, 180vw" quality={76} style={`--crop: ${product.crop}`} />
            <span class="product-index micro">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="product-meta">
            <p class="micro">{product.type}</p>
            <h3>{product.name}</h3>
            <p>{product.description}</p>
            <div><strong>{product.price}</strong><span>В меню ↗</span></div>
          </div>
        </a>
      </article>
    ))}
  </div>
  <div class="product-progress" aria-hidden="true"><span data-product-progress></span></div>
  <div class="batch-footer micro">
    <span>ЛИСТАЙТЕ, ТЯНИТЕ ИЛИ ИСПОЛЬЗУЙТЕ СТРЕЛКИ</span>
    <span>ЦЕНЫ НЕ ЯВЛЯЮТСЯ ПУБЛИЧНОЙ ОФЕРТОЙ</span>
    <a href={links.menu} target="_blank" rel="noreferrer">ВСЕ МЕНЮ ↗</a>
  </div>
</section>

<script>
  const productRun = document.querySelector<HTMLElement>('[data-product-run]');
  const productCards = productRun ? [...productRun.querySelectorAll<HTMLElement>('.product-card')] : [];
  const productCurrent = document.querySelector<HTMLElement>('[data-product-current]');
  const productProgress = document.querySelector<HTMLElement>('[data-product-progress]');
  let productFrame = 0;
  const syncProductRail = () => {
    if (!productRun || !productCards.length) return;
    const closest = productCards.reduce((best, card, index) => Math.abs(card.offsetLeft - productRun.scrollLeft) < Math.abs(productCards[best].offsetLeft - productRun.scrollLeft) ? index : best, 0);
    if (productCurrent) productCurrent.textContent = String(closest + 1).padStart(2, '0');
    if (productProgress) productProgress.style.scale = `${(closest + 1) / productCards.length} 1`;
  };
  const moveProductRail = (direction: number) => {
    if (!productRun || !productCards.length) return;
    const gap = Number.parseFloat(getComputedStyle(productRun).columnGap || '0');
    productRun.scrollBy({ left: direction * (productCards[0].offsetWidth + gap), behavior: 'smooth' });
  };
  document.querySelector('[data-products-prev]')?.addEventListener('click', () => moveProductRail(-1));
  document.querySelector('[data-products-next]')?.addEventListener('click', () => moveProductRail(1));
  productRun?.addEventListener('scroll', () => {
    cancelAnimationFrame(productFrame);
    productFrame = requestAnimationFrame(syncProductRail);
  }, { passive: true });
  syncProductRail();
</script>
