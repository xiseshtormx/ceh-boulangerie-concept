---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-shift-v2.png';
import { brand } from '../data/brand';
import { links } from '../data/links';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-bar micro">
    <span>СМЕНА <b>01</b></span>
    <span>ПЕРМЬ / 4 ТОЧКИ</span>
    <span data-clock>05:47:00</span>
  </div>
  <div class="hero-copy" data-reveal>
    <p class="eyebrow">{brand.eyebrow}</p>
    <h1 id="hero-title"><span>СЛОИ</span><span>В ДЕЛЕ.</span></h1>
    <p class="hero-lead">{brand.heroLead}</p>
    <div class="hero-actions">
      <a class="button" href={links.menu} target="_blank" rel="noreferrer">Что есть сегодня <span>↗</span></a>
      <a class="text-link" href="#locations">Найти свой Цех <span>↓</span></a>
    </div>
  </div>
  <figure class="hero-media" data-reveal style="--delay: 120ms">
    <Image src={heroImage} alt="Разлом золотистого круассана на красной бумаге и стальном столе" widths={[640, 960, 1440]} sizes="(min-width: 800px) 62vw, 100vw" quality={82} loading="eager" fetchpriority="high" />
    <figcaption>
      <span class="batch-stamp">ПАРТИЯ<br /><b>№ 0547</b></span>
      <span>ХРУСТ / ВОЗДУХ / МАСЛО</span>
    </figcaption>
  </figure>
  <div class="hero-proof micro" data-reveal style="--delay: 220ms">
    <p><strong>96</strong><span>позиций в публичном меню</span></p>
    <p><strong>4.8</strong><span>оценка точки на Луначарского</span></p>
    <p><strong>4</strong><span>адреса в Перми</span></p>
  </div>
  <p class="concept-flag micro">НЕОФИЦИАЛЬНЫЙ КОНЦЕПТ / ДАННЫЕ ПРОВЕРЕНЫ 20.07.2026</p>
</section>

<script>
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const tick = () => {
    if (clock) clock.textContent = new Intl.DateTimeFormat('ru-RU', { timeZone: 'Europe/Moscow', hour: '2-digit', minute: '2-digit', second: '2-digit' }).format(new Date());
  };
  tick();
  window.setInterval(tick, 1000);
</script>
