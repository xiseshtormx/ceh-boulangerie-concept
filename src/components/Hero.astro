---
import { Image } from 'astro:assets';
import croissant from '../assets/hero-croissant-cutout-v3.png';
import { brand } from '../data/brand';
import { imageMeta } from '../data/images';
import { links } from '../data/links';
import '../styles/hero.css';
---

<section class="ceh-hero" id="top" aria-labelledby="hero-title" data-hero>
  <div class="ceh-hero__layout">
    <h1 id="hero-title" aria-label={brand.heroTitle}>
      <span>Круассаны,</span>
      <span>кофе</span>
      <span>и завтраки<span class="ceh-hero__period">.</span></span>
    </h1>
    <div class="ceh-hero__copy">
      <p class="ceh-hero__lead">{brand.heroLead}</p>
      <div class="ceh-hero__actions">
        <a class="ceh-hero__menu" href={links.menu} target="_blank" rel="noreferrer">
          Посмотреть меню
        </a>
        <a class="ceh-hero__locations" href="#locations">Наши кофейни</a>
      </div>
    </div>

    <figure class="ceh-hero__scene" aria-describedby="hero-visual-note">
      <div class="ceh-hero__object" data-hero-object>
        <Image
          src={croissant}
          alt={imageMeta.hero.alt}
          widths={[480, 768, 1080, 1440]}
          sizes="(min-width: 1600px) 736px, (min-width: 720px) 47vw, 90vw"
          quality={84}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <figcaption id="hero-visual-note" class="ceh-hero__caption">
        Визуал концепта
      </figcaption>
    </figure>

  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const object = hero?.querySelector<HTMLElement>('[data-hero-object]');
  const motion = window.matchMedia('(prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine)');

  if (hero && object) {
    let frame = 0;
    let x = 0;
    let y = 0;
    const reset = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      object.style.removeProperty('--object-x');
      object.style.removeProperty('--object-y');
    };
    const move = (event: PointerEvent) => {
      if (!motion.matches) return;
      const bounds = hero.getBoundingClientRect();
      x = ((event.clientX - bounds.left) / bounds.width - 0.5) * 16;
      y = ((event.clientY - bounds.top) / bounds.height - 0.5) * 12;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        object.style.setProperty('--object-x', `${x.toFixed(2)}px`);
        object.style.setProperty('--object-y', `${y.toFixed(2)}px`);
        frame = 0;
      });
    };
    hero.addEventListener('pointermove', move, { passive: true });
    hero.addEventListener('pointerleave', reset);
    motion.addEventListener('change', reset);
    window.addEventListener('pagehide', reset, { once: true });
  }
</script>
