---
import { brand } from '../data/brand';
import { links } from '../data/links';
import '../styles/visit.css';

const logo = `${import.meta.env.BASE_URL}brand/ceh-logo.png`;
---

<footer class="ceh-footer ceh-visit">
  <div class="ceh-visit__inner">
    <div class="ceh-footer__top">
      <a class="ceh-footer__brand" href="#top" aria-label="Цех — наверх">
        <img src={logo} alt="Цех boulangerie" width="1200" height="650" loading="lazy" />
      </a>
      <nav class="ceh-footer__nav" aria-label="Навигация в подвале">
        <a href={links.menu} target="_blank" rel="noreferrer">Меню</a>
        <a href="#locations">Кофейни</a>
        <a href={links.vk} target="_blank" rel="noreferrer">ВКонтакте</a>
      </nav>
      <a class="ceh-footer__back ceh-visit__text-link" href="#top">Наверх</a>
    </div>
    <div class="ceh-footer__legal">
      <p>{brand.legal} На сайте использованы материалы бренда и изображения, созданные для концепта. Актуальные цены и наличие — в официальном меню.</p>
      <p>Цех boulangerie · Пермь</p>
    </div>
  </div>
</footer>
