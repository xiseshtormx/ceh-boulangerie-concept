---
import { Image } from 'astro:assets';
import breakfastTunaImage from '../assets/breakfast-tuna-real.png';
import breakfastSalmonImage from '../assets/breakfast-salmon-v1.png';
import breakfastHamImage from '../assets/breakfast-ham-v1.png';
import { links } from '../data/links';
import '../styles/menu.css';

const breakfasts = [
  {
    name: 'С тунцом',
    detail: 'Скрэмбл, паста из тунца, зерновые тосты, творожный сыр и песто.',
    image: breakfastTunaImage,
    alt: 'Завтрак с тунцом: скрэмбл, зерновые тосты, зелень и соусы на белой тарелке',
    source: 'Фотография из меню пекарни',
  },
  {
    name: 'С лососем',
    detail: 'Скрэмбл, лосось, зерновые тосты, зелень, томаты, творожный сыр и песто.',
    image: breakfastSalmonImage,
    alt: 'Визуал завтрака с лососем, скрэмблом, тостами, зеленью и томатами',
    source: 'Подача показана на иллюстрации концепта',
  },
  {
    name: 'С окороком',
    detail: 'Скрэмбл, окорок, зерновые тосты, творожный сыр, песто и томаты.',
    image: breakfastHamImage,
    alt: 'Визуал завтрака с окороком, скрэмблом, тостами и томатами',
    source: 'Подача показана на иллюстрации концепта',
  },
];
---

<section class="ceh-breakfast" id="breakfast" aria-labelledby="breakfast-title" data-ceh-breakfast>
  <div class="ceh-food__inner">
    <div class="ceh-breakfast__heading" data-reveal>
      <h2 id="breakfast-title">Завтрак<br />без спешки.</h2>
      <p>Три готовых завтрака. <br />Выберите свой.</p>
    </div>

    <div class="ceh-breakfast__body" data-reveal>
      <fieldset class="ceh-breakfast__choices" data-breakfast-choices hidden>
        <legend class="ceh-food__sr-only">Выберите готовый завтрак</legend>
        {breakfasts.map((breakfast, index) => (
          <label class="ceh-breakfast__choice">
            <input type="radio" name="ceh-breakfast" value={index} checked={index === 0} aria-controls={`breakfast-panel-${index}`} />
            <span>{breakfast.name}</span>
          </label>
        ))}
      </fieldset>

      <div class="ceh-breakfast__gallery" aria-live="polite" aria-atomic="true">
        {breakfasts.map((breakfast, index) => (
          <article class="ceh-breakfast__panel" id={`breakfast-panel-${index}`} data-breakfast-panel={index} aria-labelledby={`breakfast-name-${index}`}>
            <figure class="ceh-breakfast__figure">
              <div class="ceh-breakfast__image">
                <Image src={breakfast.image} alt={breakfast.alt} widths={[480, 800, 1200]} sizes="(min-width: 960px) 55vw, 92vw" quality={82} loading="lazy" />
              </div>
              <figcaption>{breakfast.source}</figcaption>
            </figure>
            <div class="ceh-breakfast__description">
              <h3 id={`breakfast-name-${index}`}>Завтрак <br />{breakfast.name.toLocaleLowerCase('ru')}</h3>
              <p>{breakfast.detail}</p>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="ceh-breakfast__footer" data-reveal>
      <p>Состав, наличие и цены уточняйте в меню выбранной кофейни.</p>
      <a class="ceh-food__link" href={links.menu} target="_blank" rel="noreferrer">Посмотреть завтраки в меню</a>
    </div>
  </div>
</section>

<script>
  const breakfast = document.querySelector<HTMLElement>('[data-ceh-breakfast]');
  if (breakfast) {
    const choices = breakfast.querySelector<HTMLFieldSetElement>('[data-breakfast-choices]');
    const inputs = [...breakfast.querySelectorAll<HTMLInputElement>('input[name="ceh-breakfast"]')];
    const panels = [...breakfast.querySelectorAll<HTMLElement>('[data-breakfast-panel]')];
    if (choices && inputs.length === panels.length) {
      const selectBreakfast = (index: number) => {
        panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
      };
      inputs.forEach((input, index) => input.addEventListener('change', () => {
        if (input.checked) selectBreakfast(index);
      }));
      selectBreakfast(0);
      breakfast.classList.add('is-interactive');
      choices.hidden = false;
    }
  }
</script>
