---
import { Image } from 'astro:assets';
import breakfastImage from '../assets/breakfast-tuna-real.png';
import { links } from '../data/links';

const breakfasts = [
  { name: 'С тунцом', price: '510 ₽', detail: 'Скрэмбл, паста из тунца, зерновые тосты, творожный сыр и песто.' },
  { name: 'С лососем', price: '730 ₽', detail: 'Скрэмбл, лосось, зерновые тосты, зелень, томаты, творожный сыр и песто.' },
  { name: 'С окороком', price: '590 ₽', detail: 'Скрэмбл, окорок, зерновые тосты, творожный сыр, песто и томаты.' },
];
---

<section class="breakfast section" id="breakfast" aria-labelledby="breakfast-title" data-breakfast>
  <div class="breakfast-copy" data-reveal>
    <p class="section-code micro">03 / ЗАВТРАКИ</p>
    <h2 id="breakfast-title">Соберите утро<br /><span>под себя.</span></h2>
    <p>С лососем, тунцом или окороком — выберите вариант, а мы сразу покажем состав и актуальную цену.</p>
    <div class="breakfast-options" role="tablist" aria-label="Выберите завтрак">
      {breakfasts.map((item, index) => (
        <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} class:list={{ active: index === 0 }} data-breakfast-option={index}>
          <span class="micro">0{index + 1}</span><strong>{item.name}</strong><b>{item.price}</b>
        </button>
      ))}
    </div>
    <div class="breakfast-ticket">
      <p class="micro">СОСТАВ / ПУБЛИЧНОЕ МЕНЮ</p>
      <p data-breakfast-detail>{breakfasts[0].detail}</p>
      <div><strong data-breakfast-price>{breakfasts[0].price}</strong><a href={links.menu} target="_blank" rel="noreferrer">Заказать ↗</a></div>
    </div>
  </div>
  <figure class="breakfast-image" data-reveal style="--delay: 100ms">
    <Image src={breakfastImage} alt="Сборный завтрак со скрэмблом, тунцом, зерновыми тостами, зеленью, творожным сыром и песто" widths={[720, 1200, 1700]} sizes="(min-width: 900px) 55vw, 100vw" quality={86} />
    <figcaption class="micro"><span>ЗАВТРАК С ТУНЦОМ</span><span>ФОТО ИЗ МАТЕРИАЛОВ БРЕНДА</span></figcaption>
  </figure>
</section>

<script is:inline define:vars={{ breakfasts }}>
  const breakfastRoot = document.querySelector('[data-breakfast]');
  breakfastRoot?.querySelectorAll('[data-breakfast-option]').forEach((button) => button.addEventListener('click', () => {
    const index = Number(button.dataset.breakfastOption);
    breakfastRoot.querySelectorAll('[data-breakfast-option]').forEach((item, itemIndex) => {
      item.classList.toggle('active', itemIndex === index);
      item.setAttribute('aria-selected', String(itemIndex === index));
    });
    breakfastRoot.querySelector('[data-breakfast-detail]').textContent = breakfasts[index].detail;
    breakfastRoot.querySelector('[data-breakfast-price]').textContent = breakfasts[index].price;
  }));
</script>
