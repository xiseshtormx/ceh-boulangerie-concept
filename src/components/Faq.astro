---
import { faq } from '../data/faq';
import '../styles/visit.css';
---

<section class="ceh-faq ceh-visit" id="faq" aria-labelledby="faq-title">
  <div class="ceh-faq__inner ceh-visit__inner">
    <h2 id="faq-title" data-reveal>Перед визитом.</h2>
    <div class="ceh-faq__list">
      {faq.map((item) => (
        <details class="ceh-faq__item">
          <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
          <div class="ceh-faq__answer">
            <p>{item.answer}</p>
            <a class="ceh-visit__text-link" href={item.href} target="_blank" rel="noreferrer">{item.linkLabel}</a>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
