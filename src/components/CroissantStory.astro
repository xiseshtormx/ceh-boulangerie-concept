---
import { Image } from 'astro:assets';
import processImage from '../assets/lamination-v2.png';

const stages = [
  { time: '00:00', title: 'Замес', copy: 'Тесто набирает структуру. Никаких декоративных обещаний — только начало работы.' },
  { time: '06:00', title: 'Холод', copy: 'Температура удерживает масло и тесто раздельными — будущие слои остаются читаемыми.' },
  { time: '12:00', title: 'Ламинация', copy: 'Тесто складывают и раскатывают. Именно этот момент теперь показан целиком, без странных нарезок.' },
  { time: '18:00', title: 'Формовка', copy: 'Ровные треугольники сворачиваются в узнаваемую форму.' },
  { time: '24:00', title: 'Расстойка', copy: 'Время создаёт воздушную структуру и объём перед печью.' },
  { time: '27:00', title: 'Жар', copy: 'Слои раскрываются, масло делает своё дело, поверхность становится золотой и хрустящей.' },
];
---

<section class="process" id="process" aria-labelledby="process-title" data-process>
  <div class="process-head section" data-reveal>
    <p class="section-code micro">02 / КОНТРОЛЬ ПАРТИИ</p>
    <h2 id="process-title">Карусель больше<br /><span>не режет продукт.</span></h2>
    <p>Один цельный производственный кадр. Шесть понятных этапов. Управление кнопками, стрелками клавиатуры и свайпом.</p>
  </div>
  <div class="process-console">
    <figure class="process-frame">
      <Image src={processImage} alt="Руки пекаря складывают слоёное тесто на стальном столе" widths={[760, 1320, 1900]} sizes="(min-width: 900px) 62vw, 100vw" quality={88} />
      <div class="process-scan" aria-hidden="true"></div>
      <figcaption class="micro"><span>КАМЕРА / СТОЛ 03</span><span>ЛАМИНАЦИЯ</span><span>REC ●</span></figcaption>
    </figure>
    <div class="process-readout">
      <div class="readout-top micro"><span>ЭТАП <b data-stage-number>01</b> / 06</span><span data-stage-time>00:00</span></div>
      <p class="readout-title" data-stage-title aria-live="polite">Замес</p>
      <p class="readout-copy" data-stage-copy>{stages[0].copy}</p>
      <div class="process-controls">
        <button type="button" data-process-prev aria-label="Предыдущий этап">←</button>
        <div class="process-dots" role="tablist" aria-label="Этапы производства">
          {stages.map((stage, index) => <button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-stage={index} aria-label={`${index + 1}. ${stage.title}`}></button>)}
        </div>
        <button type="button" data-process-next aria-label="Следующий этап">→</button>
      </div>
    </div>
  </div>
  <div class="process-strip" tabindex="0" aria-label="Этапы процесса; используйте стрелки влево и вправо">
    {stages.map((stage, index) => (
      <button type="button" class:list={['process-stage', { active: index === 0 }]} data-stage-card={index}>
        <span class="micro">{String(index + 1).padStart(2, '0')} / {stage.time}</span>
        <strong>{stage.title}</strong>
      </button>
    ))}
  </div>
</section>

<script is:inline define:vars={{ stages }}>
  const root = document.querySelector('[data-process]');
  if (root) {
    let active = 0;
    const stageCards = [...root.querySelectorAll('[data-stage-card]')];
    const dots = [...root.querySelectorAll('[data-stage]')];
    const setStage = (next) => {
      active = (next + stages.length) % stages.length;
      root.style.setProperty('--stage', String(active));
      root.querySelector('[data-stage-number]').textContent = String(active + 1).padStart(2, '0');
      root.querySelector('[data-stage-time]').textContent = stages[active].time;
      root.querySelector('[data-stage-title]').textContent = stages[active].title;
      root.querySelector('[data-stage-copy]').textContent = stages[active].copy;
      stageCards.forEach((item, index) => item.classList.toggle('active', index === active));
      dots.forEach((item, index) => item.setAttribute('aria-selected', String(index === active)));
      stageCards[active]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    };
    root.querySelector('[data-process-prev]')?.addEventListener('click', () => setStage(active - 1));
    root.querySelector('[data-process-next]')?.addEventListener('click', () => setStage(active + 1));
    [...root.querySelectorAll('[data-stage], [data-stage-card]')].forEach((item) => item.addEventListener('click', () => setStage(Number(item.dataset.stage ?? item.dataset.stageCard))));
    root.querySelector('.process-strip')?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') { event.preventDefault(); setStage(active + 1); }
      if (event.key === 'ArrowLeft') { event.preventDefault(); setStage(active - 1); }
    });
  }
</script>
