---
import { Image } from 'astro:assets';
import laminationImage from '../assets/process-lamination-v1.png';
import shapingImage from '../assets/process-shaping-v1.png';
import bakingImage from '../assets/process-baking-v1.png';
import '../styles/story.css';

const stages = [
  {
    title: 'Слои',
    image: laminationImage,
    alt: 'Концептуальная иллюстрация: пекарь раскатывает тесто с маслом',
    copy: 'Тесто раскатывают с маслом и складывают, чтобы получить тонкие слои.',
  },
  {
    title: 'Форма',
    image: shapingImage,
    alt: 'Концептуальная иллюстрация: пекарь сворачивает круассан из треугольника теста',
    copy: 'Треугольник теста сворачивают от основания к кончику.',
  },
  {
    title: 'Корочка',
    image: bakingImage,
    alt: 'Концептуальная иллюстрация: противень золотистых круассанов у открытой печи',
    copy: 'Во время выпечки слои раскрываются, а поверхность становится золотистой.',
  },
];
---

<section class="ceh-story" id="process" aria-labelledby="story-title" data-story>
  <div class="ceh-story__inner">
    <div class="ceh-story__intro">
      <h2 id="story-title">Началось<br />с десертов.</h2>
      <!-- Brand history source: https://mfk59.ru/news/sobyitya-i-meropriyatiya/gospodderzhka-pomogla-permskoy-pekarne-tsekh-vyrasti-v-set-iz-chetyryekh-tochek/ -->
      <p class="ceh-story__history">Елизавета Ельцова и Вячеслав Федосимов начинали с десертов для ресторанов. Затем появилась собственная пекарня.</p>
    </div>

    <div class="ceh-story__craft">
      <figure class="ceh-story__figure">
        <div class="ceh-story__images">
          {stages.map((stage, index) => (
            <Image
              id={`story-image-${index}`}
              class:list={['ceh-story__image', { 'is-active': index === 0 }]}
              src={stage.image}
              alt={stage.alt}
              widths={[480, 760, 1080, 1440]}
              sizes="(min-width: 1600px) 950px, (min-width: 900px) 62vw, 91vw"
              quality={78}
              loading="lazy"
              decoding="async"
              aria-hidden={index === 0 ? 'false' : 'true'}
              data-story-image={index}
            />
          ))}
        </div>
        <figcaption>Иллюстрации процесса созданы для концепта</figcaption>
      </figure>

      <div class="ceh-story__details">
        <div class="ceh-story__choices" role="group" aria-label="Рассмотреть процесс" hidden data-story-controls>
          {stages.map((stage, index) => (
            <button
              type="button"
              aria-pressed={index === 0 ? 'true' : 'false'}
              aria-controls={`story-image-${index} story-description`}
              data-story-stage={index}
              data-story-description={stage.copy}
            >{stage.title}</button>
          ))}
        </div>
        <p id="story-description" class="ceh-story__description" aria-live="polite" aria-atomic="true" data-story-copy>{stages[0].copy}</p>
      </div>
    </div>
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]');

  if (story) {
    const controls = story.querySelector<HTMLElement>('[data-story-controls]');
    const buttons = [...story.querySelectorAll<HTMLButtonElement>('[data-story-stage]')];
    const images = [...story.querySelectorAll<HTMLImageElement>('[data-story-image]')];
    const copy = story.querySelector<HTMLElement>('[data-story-copy]');

    if (controls && copy && buttons.length === images.length && buttons.length > 0) {
      const selectStage = (index: number) => {
        if (!buttons[index]) return;
        buttons.forEach((button, stageIndex) => {
          button.setAttribute('aria-pressed', String(stageIndex === index));
        });
        images.forEach((image, stageIndex) => {
          const active = stageIndex === index;
          image.classList.toggle('is-active', active);
          image.setAttribute('aria-hidden', String(!active));
        });
        copy.textContent = buttons[index].dataset.storyDescription ?? '';
      };

      buttons.forEach((button, index) => {
        button.addEventListener('click', () => selectStage(index));
      });
      controls.hidden = false;
    }
  }
</script>
