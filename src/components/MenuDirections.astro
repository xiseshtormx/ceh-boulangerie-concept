---
import { Image } from 'astro:assets';
import { categories } from '../data/categories';
import { links } from '../data/links';
import tunaCroissant from '../assets/hot-croissant-tuna-real.png';
import hamCroissant from '../assets/hot-croissant-ham-real.png';
import salmonCroissant from '../assets/hot-croissant-salmon-real.png';
import '../styles/menu.css';

const hotCroissants = [
  { name: 'С тунцом', image: tunaCroissant, alt: 'Горячий круассан с тунцом, огурцом и зеленью на белой тарелке' },
  { name: 'С окороком и сыром', image: hamCroissant, alt: 'Горячий круассан с окороком, сыром и зеленью на белой тарелке' },
  { name: 'С лососем', image: salmonCroissant, alt: 'Горячий круассан с лососем на белой тарелке' },
];
---

<section class="ceh-menu" id="menu" aria-labelledby="menu-title">
  <div class="ceh-food__inner">
    <div class="ceh-menu__heading" data-reveal>
      <h2 id="menu-title">Круассан<br />на обед.</h2>
      <div>
        <p>Тот самый круассан —<br />теперь с сытной начинкой.</p>
        <a class="ceh-food__link" href={links.menu} target="_blank" rel="noreferrer">Открыть всё меню</a>
      </div>
    </div>

    <div class="ceh-menu__croissants" aria-label="Горячие круассаны">
      {hotCroissants.map((croissant, index) => (
        <figure class:list={['ceh-menu__dish', { 'ceh-menu__dish--large': index === 0 }]} data-reveal>
          <div class="ceh-menu__dish-image">
            <Image src={croissant.image} alt={croissant.alt} widths={index === 0 ? [600, 960, 1440] : [400, 640, 900]} sizes={index === 0 ? '(min-width: 960px) 55vw, 92vw' : '(min-width: 960px) 31vw, 44vw'} quality={82} loading="lazy" />
          </div>
          <figcaption>{croissant.name}</figcaption>
        </figure>
      ))}
    </div>
    <p class="ceh-menu__photo-note">Фотографии из меню пекарни</p>

    <div class="ceh-menu__categories" aria-label="Что ещё есть в меню">
      {categories.map((category) => (
        <article data-reveal>
          <h3>{category.title}</h3>
          <p>{category.tags.join(', ')}.</p>
        </article>
      ))}
    </div>
    <div class="ceh-menu__footer" data-reveal>
      <p>Полный ассортимент и цены — в меню выбранной кофейни.</p>
      <a class="ceh-food__link" href={links.menu} target="_blank" rel="noreferrer">Выбрать кофейню и посмотреть меню</a>
    </div>
  </div>
</section>
