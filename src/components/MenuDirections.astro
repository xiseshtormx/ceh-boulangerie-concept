---
import { categories } from '../data/categories';
import { links } from '../data/links';
---

<section class="menu-manifest section" id="menu" aria-labelledby="menu-title">
  <div class="menu-head" data-reveal>
    <p class="section-code micro">04 / МЕНЮ-МАНИФЕСТ</p>
    <h2 id="menu-title">Круассан — герой.<br /><span>Но не всё меню.</span></h2>
    <p>Сайт работает как реклама только тогда, когда не прячет ширину предложения. Пять направлений — от выпечки до полноценного обеда.</p>
  </div>
  <div class="menu-grid">
    {categories.map((category, index) => (
      <article class="menu-category" data-reveal style={`--delay: ${index * 55}ms`}>
        <div class="menu-category-title"><span class="micro">{category.number}</span><h3>{category.title}</h3></div>
        <p>{category.note}</p>
        <ul>{category.tags.map((tag) => <li><span>→</span>{tag}</li>)}</ul>
      </article>
    ))}
  </div>
  <div class="menu-total" data-reveal>
    <p><strong>96</strong><span>позиций в публичном меню</span></p>
    <p><strong>7</strong><span>видов выпечки</span></p>
    <p><strong>10</strong><span>завтраков</span></p>
    <p><strong>12</strong><span>десертов</span></p>
    <a class="button button--ink" href={links.menu} target="_blank" rel="noreferrer">Смотреть всё меню <span>↗</span></a>
  </div>
  <p class="source-note micro">ИСТОЧНИК: ПУБЛИЧНОЕ МЕНЮ 2ГИС / ОБНОВЛЕНО 20.02.2026 / ЦЕНЫ МОГУТ МЕНЯТЬСЯ</p>
</section>
