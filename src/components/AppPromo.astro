---
import { links } from '../data/links';
import '../styles/visit.css';
---

<section class="ceh-app ceh-visit" id="app" aria-labelledby="app-title">
  <div class="ceh-app__inner ceh-visit__inner" data-reveal>
    <h2 id="app-title">Цех в телефоне.</h2>
    <p>Официальное приложение для тех, кто заглядывает к нам часто.</p>
    <a class="ceh-visit__button" href={links.android} target="_blank" rel="noreferrer">Открыть Google Play</a>
  </div>
</section>
