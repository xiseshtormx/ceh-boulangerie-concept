---
import { branches } from '../data/branches';
import '../styles/visit.css';
---

<section class="ceh-locations ceh-visit" id="locations" aria-labelledby="locations-title">
  <div class="ceh-visit__inner">
    <div class="ceh-locations__intro" data-reveal>
      <h2 id="locations-title">Здесь,<br />в Перми.</h2>
      <p>Четыре пекарни в городе.<br />Выберите, куда заглянуть сегодня.</p>
    </div>
    <div class="ceh-locations__grid">
      {branches.map((branch) => (
        <article class="ceh-locations__address" data-reveal>
          <p>{branch.area}</p>
          <h3>{branch.address.replace(/ (\S+)$/, '\u00a0$1')}</h3>
          <a class="ceh-visit__text-link" href={branch.route} target="_blank" rel="noreferrer" aria-label={`Маршрут в 2ГИС: ${branch.address}`}>
            Маршрут в 2ГИС
          </a>
        </article>
      ))}
    </div>
    <p class="ceh-locations__note">Часы работы и изменения в расписании — в карточке выбранной пекарни в 2ГИС.</p>
  </div>
</section>
